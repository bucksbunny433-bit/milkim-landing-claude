---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Portfolio from "../components/Portfolio.astro";
import Prices from "../components/Prices.astro";
import Process from "../components/Process.astro";
import Master from "../components/Master.astro";
import Reviews from "../components/Reviews.astro";
import Faq from "../components/Faq.astro";
import Contacts from "../components/Contacts.astro";
---

<Base
  title="Milkim — перманентный макияж и перекрытие старого татуажа в Омске"
  description="Брови, губы и перекрытие старого перманента. Один мастер, форма по геометрии лица, эскиз до процедуры. Омск, ул. Дмитриева, 5/1."
>
  <main id="main">
    <Hero />
    <Portfolio />
    <Process />
    <Prices />
    <Master />
    <Reviews />
    <Faq />
    <Contacts />
  </main>
</Base>
