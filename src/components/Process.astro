---
import { Image } from "astro:assets";
import consult from "../assets/process/consult.png";
import sketch from "../assets/process/sketch.png";
import procedure from "../assets/process/procedure.png";
import healing from "../assets/process/healing.png";
import correction from "../assets/process/correction.png";

// Numbered because this genuinely is a sequence - each step only makes sense after
// the one before it. Wording is the master's own, from the studio's answers.
const steps = [
  {
    n: "01",
    title: "Консультация",
    text: "Выясняю, чего вы хотите: форма, желаемый цвет, результат. Собираю анамнез. Рассказываю про все этапы и про то, как будет идти заживление.",
    image: consult,
    alt: "Консультация в студии Milkim перед процедурой",
  },
  {
    n: "02",
    title: "Эскиз",
    text: "Форма строится по геометрическим точкам вашего лица. Эскиз я отрисовываю до внесения пигмента — форму вы видите заранее.",
    image: sketch,
    alt: "Мастер размечает форму бровей перед процедурой",
  },
  {
    n: "03",
    title: "Процедура",
    text: "Тонкая игла в верхнем слое дермы, движения похожи на выщипывание бровей. Использую анестетик. Около двух часов на любую зону, инструмент и расходники — индивидуальные и стерильные.",
    image: procedure,
    alt: "Мастер выполняет процедуру перманентного макияжа",
  },
  {
    n: "04",
    title: "Заживление",
    text: "Корочка сходит за неделю, а дерма восстанавливается целый месяц. Через две недели я сама связываюсь и спрашиваю, как идёт. Полную картину видно только через месяц.",
    image: healing,
    // Describes what is actually in the frame. The photograph illustrates the studio's
    // work; it does not claim to be a picture of someone's healing.
    alt: "Мастер осматривает брови клиентки в студии",
  },
  {
    n: "05",
    title: "Коррекция",
    text: "Через 1–1,5 месяца. Закрывает пробелы, которые иногда остаются после первого раза, добавляет второй слой пигмента для более долгой носки и позволяет поправить оттенок.",
    image: correction,
    alt: "Мастер дорабатывает форму бровей на втором визите",
  },
];
---

<section class="mk-on-dark process" id="process">
  <div class="mk-container">
    <div class="process__head">
      <h2 class="process__title" data-reveal="lines">
        <span class="line"><span>От разговора</span></span>
        <span class="line"><span>до зажившего</span></span>
        <span class="line"><span>результата</span></span>
      </h2>
      <p class="process__lead">
        Два визита и месяц между ними. Ничего неожиданного в кабинете не будет.
      </p>
    </div>
  </div>

  {/*
    Each step owns a screen and its photograph pins for the length of that step's text,
    then hands over to the next one. It is position: sticky and nothing else - no script,
    no scroll library, and it behaves the same in every browser.
  */}
  <ol class="steps" role="list">
    {
      steps.map((s) => (
        <li class="step">
          <div class="mk-container step__grid">
            <div class="step__media">
              {s.image ? (
                <Image
                  src={s.image}
                  alt={s.alt}
                  widths={[320, 520, 760]}
                  width={760}
                  sizes="(min-width: 900px) 44vw, 92vw"
                  format="avif"
                  quality={58}
                  loading="lazy"
                  decoding="async"
                  class="step__img mk-arch-soft"
                />
              ) : (
                <span class="step__numeral" aria-hidden="true">
                  {s.n}
                </span>
              )}
            </div>

            <div class="step__copy">
              <p class="step__n" aria-hidden="true">
                {s.n}
              </p>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    padding-block: var(--mk-section-y) 0;
  }

  .process__head {
    margin-bottom: var(--mk-space-8);
  }

  .process__title {
    font-size: var(--mk-step-h2);
    line-height: 1.02;
    letter-spacing: var(--mk-tracking-display);
    font-weight: 400;
    margin-bottom: var(--mk-space-5);
  }

  .process__title .line {
    display: block;
  }

  .process__lead {
    font-size: var(--mk-step-lead);
    line-height: var(--mk-leading-body);
    color: var(--mk-muted);
    max-width: 30rem;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    padding-block: var(--mk-space-7);
    border-top: 1px solid var(--mk-rule);
  }

  .step__grid {
    display: grid;
    gap: var(--mk-space-5);
  }

  .step__media {
    position: relative;
    isolation: isolate;
  }

  .step__img {
    width: 100%;
    height: auto;
    /* 4:3, not a portrait crop: three of these five frames are landscape, and at 4:5
       the consultation shot lost both people and kept the pot plant. The arch still
       reads at this ratio - it is a doorway rather than a mirror. */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 42%;
  }

  .step__media::before {
    content: "";
    position: absolute;
    inset: -8% -6%;
    z-index: -1;
    background: radial-gradient(
      58% 52% at 50% 44%,
      color-mix(in oklab, var(--mk-gold) 10%, transparent) 0%,
      transparent 74%
    );
    pointer-events: none;
  }

  /* Steps four and five have no photograph - healing and the correction visit happen
     away from the studio. Rather than borrow an unrelated picture, the step number
     stands in at display scale. */
  .step__numeral {
    display: block;
    font-family: var(--mk-font-display);
    font-size: clamp(7rem, 30vw, 14rem);
    line-height: 0.8;
    color: color-mix(in oklab, var(--mk-accent) 22%, transparent);
  }

  .step__n {
    font-family: var(--mk-font-display);
    font-size: var(--mk-step-small);
    letter-spacing: 0.2em;
    color: var(--mk-accent);
    margin-bottom: var(--mk-space-3);
  }

  .step__title {
    font-size: var(--mk-step-h3);
    font-weight: 400;
    margin-bottom: var(--mk-space-3);
  }

  .step__text {
    font-size: var(--mk-step-small);
    line-height: var(--mk-leading-body);
    color: var(--mk-muted);
    max-width: 34rem;
  }

  @media (min-width: 900px) {
    .step {
      padding-block: var(--mk-space-9);
    }

    .step__grid {
      grid-template-columns: 44% 1fr;
      gap: var(--mk-space-9);
      align-items: start;
    }

    /* The photograph pins while its own text passes, then releases as the next step
       arrives. One property, no script. */
    .step__media {
      position: sticky;
      top: 18vh;
    }

    .step__copy {
      padding-top: var(--mk-space-5);
      min-height: 46vh;
    }

    .step__title {
      font-size: var(--mk-step-h2);
      line-height: 1.05;
      letter-spacing: var(--mk-tracking-display);
      margin-bottom: var(--mk-space-5);
    }

    .step__text {
      font-size: var(--mk-step-body);
    }

    .step__numeral {
      font-size: clamp(12rem, 18vw, 20rem);
    }
  }
</style>
