---
import { Image } from "astro:assets";
import type { CaseData } from "../types";

interface Props {
  data: CaseData;
  index: number;
}

const { data, index } = Astro.props;

// Every portfolio source lives in src/assets/portfolio, so one glob resolves them
// all. Adding a case means dropping in a folder - no markup changes, which is the
// condition the client set.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portfolio/**/*.{jpg,jpeg,png,JPG,PNG}",
  { eager: true },
);

// A collage is shown at its own proportions: cropping one to the card ratio would
// cut into the halves being compared, which is the entire content of the image.
// The ratio is read from the data file, never from the imported image object -
// touching .width on ImageMetadata inside the template makes Astro emit the
// untouched original alongside the derivatives, which turned a 3.4 MB build into
// 53 MB of full-size PNGs nobody would ever download.
const frames = data.frames
  .map((f) => ({
    ...f,
    src: files[`../assets/portfolio/${f.file}`]?.default,
    ratio: f.mode === "collage" ? `aspect-ratio:${f.w}/${f.h}` : undefined,
    // A collage packs two to four faces into one square, so it needs more pixels
    // than a single portrait to stay readable at the same card width.
    widths: f.mode === "collage" ? [340, 680, 1020] : [220, 340, 680],
    width: f.mode === "collage" ? 1020 : 680,
    quality: f.mode === "collage" ? 64 : 58,
  }))
  .filter((f) => f.src);

const stageCount = frames.filter((f) => f.mode === "stage").length;
const alt = `${data.serviceTitle}, работа ${data.number}`;
---

<article class="case" data-reveal style={`--i:${index % 4}`}>
  <div class={`case__frames case__frames--${stageCount || 1}`}>
    {
      frames.map((f) => (
        <figure class="case__frame">
          <Image
            src={f.src!}
            alt={`${alt} — ${f.label.toLowerCase()}`}
            widths={f.widths}
            width={f.width}
            sizes="(min-width: 680px) 20vw, 85vw"
            format="avif"
            quality={f.quality}
            loading="lazy"
            decoding="async"
            class={`case__img case__img--${f.mode}`}
            style={f.ratio}
          />
          <figcaption class={`case__label${f.marked ? " case__label--marked" : ""}`}>
            {f.label}
          </figcaption>
        </figure>
      ))
    }
  </div>
</article>

<style>
  .case {
    display: grid;
    gap: var(--mk-space-3);
  }

  /* On a phone the stages stack. Side by side, three frames in one card are about
     85px wide each, and nobody can judge a brow at 85px - which is the entire job
     of this section. Stacked, each frame gets the full card width. */
  .case__frames {
    display: grid;
    gap: var(--mk-space-3);
    grid-template-columns: 1fr;
  }

  .case__frames--1 {
    --n: 1;
  }
  .case__frames--2 {
    --n: 2;
  }
  .case__frames--3 {
    --n: 3;
  }

  @media (min-width: 680px) {
    .case__frames {
      gap: var(--mk-space-2);
      grid-template-columns: repeat(var(--n, 2), 1fr);
    }
  }

  .case__frame {
    margin: 0;
    display: grid;
    gap: var(--mk-space-2);
  }

  .case__img {
    width: 100%;
    height: auto;
    background-color: color-mix(in oklab, var(--mk-text) 6%, transparent);
  }

  /* A single portrait is cropped to a common ratio so a row of cards lines up. */
  .case__img--stage {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* A collage keeps its own ratio, set inline from the file's real dimensions. */
  .case__img--collage {
    object-fit: contain;
  }

  .case__label {
    font-size: var(--mk-step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  .case__label--marked {
    color: var(--mk-gold-ink);
    border-bottom: 1px dashed currentColor;
    padding-bottom: 2px;
    justify-self: start;
  }
</style>
