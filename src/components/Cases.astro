---
import { Image } from "astro:assets";
import casesJson from "../content/cases.json";
import type { CaseData } from "../types";

const cases = casesJson as CaseData[];

// One glob for every portfolio source: adding a case stays a folder plus a data entry,
// never a markup change.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portfolio/**/*.{jpg,jpeg,png,JPG,PNG}",
  { eager: true },
);

// Strongest proof first: a full before → fresh → healed set answers the question the
// studio's research calls decisive. Pairs next, single collages last.
const RANK: Record<string, number> = { timeline: 0, pair: 1, collage: 2 };

const groups = [
  {
    id: "brows",
    title: "Брови",
    note: "Форма по геометрии лица, цвет под типаж.",
    items: cases.filter((c) => c.service === "brows"),
  },
  {
    id: "coverup",
    title: "Перекрытие",
    note: "Работа поверх чужого пигмента. Берётся не любой случай.",
    items: cases.filter((c) => c.service === "correction"),
  },
].map((g) => ({
  ...g,
  items: g.items
    .sort((a, b) => RANK[a.kind] - RANK[b.kind] || a.number - b.number)
    .map((c, i) => ({
      ...c,
      position: i + 1,
      total: g.items.length,
      // Only frames whose file actually resolved, so a missing photo can never render
      // an empty stage tab.
      frames: c.frames
        .map((f) => ({
          ...f,
          src: files[`../assets/portfolio/${f.file}`]?.default,
          // "Через месяц, зажившее" is right in the alt text and too long for a chip.
          short: f.label.split(",")[0],
        }))
        .filter((f) => f.src),
    })),
}));
---

<section class="mk-on-dark works" id="works">
  <div class="mk-container">
    <div class="works__head">
      <h2 class="works__title" data-reveal="lines">
        <span class="line"><span>Одна работа</span></span>
        <span class="line"><span>— один экран</span></span>
      </h2>
      <p class="works__lead">
        Сразу после процедуры цвет ярче, через месяц он уходит на 40–50%. Поэтому у каждой
        работы обе стадии.
      </p>
    </div>
  </div>

  {/*
    Radios, not buttons: the group switch and the stage switch both work with JavaScript
    off, are operable from the keyboard, and are announced as a real choice.
  */}
  <input class="mk-sr" type="radio" name="works-group" id="works-tab-brows" checked />
  <input class="mk-sr" type="radio" name="works-group" id="works-tab-coverup" />

  <div class="mk-container works__tabs" role="presentation">
    {
      groups.map((g) => (
        <label class="works__tab" for={`works-tab-${g.id}`}>
          <span class="works__tab-name">{g.title}</span>
          <span class="works__tab-n">{g.items.length}</span>
        </label>
      ))
    }
  </div>

  <div class="works__decks">
    {
      groups.map((g) => (
        <div class="deck" data-deck={g.id}>
          <div class="deck__track" data-track tabindex="0" role="group" aria-label={`Работы: ${g.title}`}>
            {g.items.map((c) => (
              <article class="case" id={`case-${c.id}`}>
                <div class="case__inner">
                  {/* The case number as a piece of art, not a label: it sits behind the
                      photograph at display scale and drifts against it. */}
                  <span class="case__ghost" aria-hidden="true">
                    {String(c.position).padStart(2, "0")}
                  </span>

                  <p class="case__meta">
                    <span class="case__count">
                      <b>{String(c.position).padStart(2, "0")}</b> / {c.total}
                    </span>
                    <span class="case__service">{c.serviceTitle}</span>
                  </p>

                  {/* Stage state lives in radios that sit before the frames, which is
                      what lets a sibling selector cross-fade them with no script. */}
                  {c.frames.length > 1 &&
                    c.frames.map((_f, i) => (
                      <input
                        class="mk-sr case__state"
                        type="radio"
                        name={`stage-${c.id}`}
                        id={`stage-${c.id}-${i}`}
                        checked={i === 0}
                      />
                    ))}

                  <div class="case__frame">
                    {c.frames.map((f, i) => (
                      <Image
                        src={f.src!}
                        alt={`${c.serviceTitle}, работа ${c.number} — ${f.label.toLowerCase()}`}
                        widths={[340, 560, 760]}
                        width={760}
                        sizes="(min-width: 900px) 46vw, 92vw"
                        format="avif"
                        quality={f.mode === "collage" ? 58 : 54}
                        {/* Every frame is lazy: the deck sits well below the fold, and
                            eager-loading the first case's three stages put 332 KB of
                            portfolio into the first view for pictures nobody had
                            scrolled to yet. */}
                        loading="lazy"
                        decoding="async"
                        class="case__img"
                        data-i={i}
                      />
                    ))}
                  </div>

                  {c.frames.length > 1 ? (
                    <div class="case__stages">
                      {c.frames.map((f, i) => (
                        <label class="case__stage" for={`stage-${c.id}-${i}`}>
                          {f.short}
                        </label>
                      ))}
                    </div>
                  ) : (
                    <p class="case__single">{c.frames[0]?.label}</p>
                  )}
                </div>
              </article>
            ))}
          </div>

          <div class="mk-container deck__controls">
            <button class="deck__arrow" type="button" data-dir="-1" aria-label="Предыдущая работа">
              ←
            </button>
            <button class="deck__arrow" type="button" data-dir="1" aria-label="Следующая работа">
              →
            </button>
            <span class="deck__hint">Листайте вбок</span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .works {
    position: relative;
    padding-block: var(--mk-section-y);
    overflow: clip;
  }

  .works__head {
    margin-bottom: var(--mk-space-7);
  }

  /* The heading arrives line by line from behind its own mask, the same gesture as the
     hero, so the page has one vocabulary instead of a different effect per section. */
  .works__title {
    font-size: var(--mk-step-h2);
    line-height: 1.02;
    letter-spacing: var(--mk-tracking-display);
    font-weight: 400;
    margin-bottom: var(--mk-space-5);
  }

  .works__title .line {
    display: block;
  }

  .works__lead {
    font-size: var(--mk-step-lead);
    line-height: var(--mk-leading-body);
    color: var(--mk-muted);
    max-width: 32rem;
  }

  /* ---- group switch: a rule that slides, not a pill ---- */
  .works__tabs {
    display: flex;
    gap: var(--mk-space-6);
    margin-bottom: var(--mk-space-6);
  }

  .works__tab {
    display: inline-flex;
    align-items: baseline;
    gap: var(--mk-space-2);
    min-height: var(--mk-hit);
    padding-block: var(--mk-space-2);
    cursor: pointer;
    position: relative;
    color: color-mix(in oklab, var(--mk-text) 42%, transparent);
    transition: color var(--mk-dur-base) var(--mk-ease-out);
  }

  .works__tab-name {
    font-family: var(--mk-font-display);
    font-size: var(--mk-step-h3);
  }

  .works__tab-n {
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    color: var(--mk-accent);
  }

  .works__tab::after {
    content: "";
    position: absolute;
    inset: auto 0 6px 0;
    height: 1px;
    background-color: var(--mk-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--mk-dur-base) var(--mk-ease-out);
  }

  #works-tab-brows:checked ~ .works__tabs .works__tab:nth-child(1),
  #works-tab-coverup:checked ~ .works__tabs .works__tab:nth-child(2) {
    color: var(--mk-text);
  }

  #works-tab-brows:checked ~ .works__tabs .works__tab:nth-child(1)::after,
  #works-tab-coverup:checked ~ .works__tabs .works__tab:nth-child(2)::after {
    transform: scaleX(1);
  }

  #works-tab-brows:checked ~ .works__decks [data-deck="coverup"],
  #works-tab-coverup:checked ~ .works__decks [data-deck="brows"] {
    display: none;
  }

  #works-tab-brows:focus-visible ~ .works__tabs .works__tab:nth-child(1),
  #works-tab-coverup:focus-visible ~ .works__tabs .works__tab:nth-child(2) {
    outline: 2px solid var(--mk-focus);
    outline-offset: 4px;
  }

  /* ---- the deck ---- */
  .deck__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .deck__track::-webkit-scrollbar {
    display: none;
  }

  .case {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .case__inner {
    position: relative;
    width: min(100% - 2 * var(--mk-gutter), var(--mk-max-width));
    margin-inline: auto;
    display: grid;
    gap: var(--mk-space-4);
  }

  .case__ghost {
    position: absolute;
    z-index: 2;
    left: -0.06em;
    bottom: 3.6rem;
    font-family: var(--mk-font-display);
    font-size: clamp(6.5rem, 26vw, 11rem);
    line-height: 0.78;
    color: var(--mk-gold);
    opacity: 0.5;
    mix-blend-mode: overlay;
    pointer-events: none;
    user-select: none;
  }

  .case__meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: var(--mk-space-3);
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  .case__count {
    font-variant-numeric: tabular-nums;
  }

  .case__count b {
    font-weight: 500;
    color: var(--mk-text);
  }

  /* The group tab right above already says which service this is. */
  .case__service {
    display: none;
  }

  /* One fixed box for every case. The photographs differ wildly in shape - 1:1 collages,
     3:4 portraits, one 16:9 - so they are contained, never cropped, and centred. */
  .case__frame {
    position: relative;
    z-index: 1;
    height: min(62svh, 520px);
  }

  /* display, not opacity, for the stage that is not showing: a lazy image that is merely
     transparent is still fetched, and the two unselected stages of the first case alone
     put ~100 KB into the first view. The arrival is an animation rather than a
     transition, because a transition cannot run on an element that just came back into
     display. */
  .case__img {
    display: none;
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }

  /* The "before" frame is the base layer and stays put. A later stage is a sheet that
     wipes across it, so the change reads as the transformation itself rather than as two
     pictures swapping places. That wipe is the one moment on this page that sells what
     the studio actually does. */
  .case__img:only-child,
  .case__img[data-i="0"] {
    display: block;
  }

  .case__img[data-i="0"] {
    animation: mk-stage-in 720ms var(--mk-ease-out) both;
  }

  .case__state:nth-of-type(2):checked ~ .case__frame .case__img[data-i="1"],
  .case__state:nth-of-type(3):checked ~ .case__frame .case__img[data-i="2"] {
    display: block;
    animation: mk-stage-wipe 900ms var(--mk-ease-inout) both;
  }

  @keyframes mk-stage-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(1.02);
    }
  }

  @keyframes mk-stage-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ---- stage switch: rules under words, no chips ---- */
  .case__stages {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-5);
  }

  .case__stage {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--mk-hit);
    font-size: var(--mk-step-small);
    color: color-mix(in oklab, var(--mk-text) 46%, transparent);
    cursor: pointer;
    transition: color var(--mk-dur-fast) var(--mk-ease-out);
  }

  .case__stage::after {
    content: "";
    position: absolute;
    inset: auto 0 8px 0;
    height: 1px;
    background-color: var(--mk-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--mk-dur-base) var(--mk-ease-out);
  }

  .case__state:nth-of-type(1):checked ~ .case__stages .case__stage:nth-child(1),
  .case__state:nth-of-type(2):checked ~ .case__stages .case__stage:nth-child(2),
  .case__state:nth-of-type(3):checked ~ .case__stages .case__stage:nth-child(3) {
    color: var(--mk-text);
  }

  .case__state:nth-of-type(1):checked ~ .case__stages .case__stage:nth-child(1)::after,
  .case__state:nth-of-type(2):checked ~ .case__stages .case__stage:nth-child(2)::after,
  .case__state:nth-of-type(3):checked ~ .case__stages .case__stage:nth-child(3)::after {
    transform: scaleX(1);
  }

  .case__state:nth-of-type(1):focus-visible ~ .case__stages .case__stage:nth-child(1),
  .case__state:nth-of-type(2):focus-visible ~ .case__stages .case__stage:nth-child(2),
  .case__state:nth-of-type(3):focus-visible ~ .case__stages .case__stage:nth-child(3) {
    outline: 2px solid var(--mk-focus);
    outline-offset: 4px;
  }

  .case__single {
    position: relative;
    z-index: 1;
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
  }

  /* ---- controls ---- */
  .deck__controls {
    display: flex;
    align-items: center;
    gap: var(--mk-space-4);
    margin-top: var(--mk-space-6);
  }

  .deck__arrow {
    width: 52px;
    height: 52px;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--mk-text);
    background: none;
    border: 1px solid color-mix(in oklab, var(--mk-text) 22%, transparent);
    border-radius: 50%;
    cursor: pointer;
    transition:
      border-color var(--mk-dur-fast) var(--mk-ease-out),
      background-color var(--mk-dur-fast) var(--mk-ease-out),
      color var(--mk-dur-fast) var(--mk-ease-out);
  }

  :global(html.js) .deck__arrow {
    display: inline-flex;
  }

  .deck__hint {
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  /* Scroll-driven, so the movement follows the finger instead of firing on a timer.
     The photograph and its numeral travel at different speeds - that difference is what
     makes a swipe feel like depth rather than a slideshow. */
  @supports (animation-timeline: view(inline)) {
    @media (prefers-reduced-motion: no-preference) {
      .case__frame,
      .case__stages,
      .case__meta {
        animation: mk-case-in linear both;
        animation-timeline: view(inline);
        animation-range: entry 10% cover 40%;
      }

      .case__ghost {
        animation: mk-ghost-drift linear both;
        animation-timeline: view(inline);
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes mk-case-in {
    from {
      opacity: 0.2;
      transform: translateY(22px);
    }
  }

  @keyframes mk-ghost-drift {
    from {
      transform: translateX(38%);
    }
    to {
      transform: translateX(-38%);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .works__tab:hover {
      color: var(--mk-text);
    }

    .case__stage:hover {
      color: var(--mk-text);
    }

    .deck__arrow:hover {
      border-color: var(--mk-gold);
      background-color: var(--mk-gold);
      color: var(--mk-on-gold);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case__stage,
    .case__stage::after,
    .works__tab,
    .works__tab::after,
    .deck__arrow {
      transition-duration: 1ms;
    }

    .case__img,
    .case__state:checked ~ .case__frame .case__img {
      animation-duration: 1ms;
    }
  }

  @media (min-width: 900px) {
    .case__inner {
      grid-template-columns: minmax(0, 40rem) 17rem;
      grid-template-rows: auto 1fr;
      justify-content: start;
      column-gap: var(--mk-space-8);
      align-items: start;
    }

    .case__frame {
      grid-column: 1;
      grid-row: 1 / span 2;
      height: 600px;
    }

    .case__meta {
      grid-column: 2;
      grid-row: 1;
      padding-top: var(--mk-space-4);
    }

    .case__stages {
      grid-column: 2;
      grid-row: 2;
      flex-direction: column;
      align-items: flex-start;
      align-self: start;
      gap: var(--mk-space-3);
    }

    .case__single {
      grid-column: 2;
      grid-row: 2;
    }

    /* On a wide screen there is real empty space beside the photograph, so the numeral
       goes back behind everything at full size instead of sitting on a face. */
    .case__ghost {
      z-index: 0;
      left: auto;
      right: 3%;
      bottom: auto;
      top: 26%;
      font-size: clamp(11rem, 17vw, 19rem);
      opacity: 0.15;
      mix-blend-mode: normal;
    }

    .case__service {
      display: inline;
    }

    .deck__hint {
      display: none;
    }
  }
</style>

<script>
  // Two jobs only: let the arrows page the deck, and mark that JS is present so they
  // are shown at all. Everything else in this section is CSS.
  document.documentElement.classList.add("js");

  for (const deck of document.querySelectorAll<HTMLElement>("[data-deck]")) {
    const track = deck.querySelector<HTMLElement>("[data-track]");
    if (!track) continue;

    for (const btn of deck.querySelectorAll<HTMLButtonElement>(".deck__arrow")) {
      btn.addEventListener("click", () => {
        const dir = Number(btn.dataset.dir ?? 1);
        track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });
      });
    }
  }
</script>
