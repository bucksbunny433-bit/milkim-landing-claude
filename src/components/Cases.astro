---
import { Image } from "astro:assets";
import casesJson from "../content/cases.json";
import type { CaseData } from "../types";

const cases = casesJson as CaseData[];

// One glob for every portfolio source: adding a case stays a folder plus a data entry,
// never a markup change.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portfolio/**/*.{jpg,jpeg,png,JPG,PNG}",
  { eager: true },
);

const ROLE_ALT: Record<string, string> = { before: "до процедуры", after: "после процедуры" };

const groups = [
  { id: "brows", title: "Брови", items: cases.filter((c) => c.service === "brows") },
  { id: "coverup", title: "Перекрытие", items: cases.filter((c) => c.service === "correction") },
].map((g) => ({
  ...g,
  items: g.items.map((c, i) => ({
    ...c,
    position: i + 1,
    total: g.items.length,
    // The card takes the shape of its own photograph instead of forcing every case into
    // one box: a supplied collage is never cropped, and a pair is exactly two frames wide.
    // Only frames whose file actually resolved, so a missing photo can never render an
    // empty card.
    frames: c.frames
      .map((f) => ({ ...f, src: files[`../assets/portfolio/${f.file}`]?.default }))
      .filter((f) => f.src),
  })),
}));
---

<section class="mk-on-dark works" id="works">
  <div class="mk-container">
    <div class="works__head">
      <h2 class="works__title" data-reveal="lines">
        <span class="line"><span>Мои работы</span></span>
      </h2>
      <p class="works__lead">
        Сразу после процедуры цвет ярче — через месяц он уходит на 40–50%.
      </p>
    </div>
  </div>

  {/*
    Radios, not buttons: the group switch works with JavaScript off, is operable from the
    keyboard, and is announced as a real choice.
  */}
  <input class="mk-sr" type="radio" name="works-group" id="works-tab-brows" checked />
  <input class="mk-sr" type="radio" name="works-group" id="works-tab-coverup" />

  <div class="mk-container works__tabs" role="presentation">
    {
      groups.map((g) => (
        <label class="works__tab" for={`works-tab-${g.id}`}>
          <span class="works__tab-name">{g.title}</span>
          <span class="works__tab-n">{g.items.length}</span>
        </label>
      ))
    }
  </div>

  <div class="works__decks">
    {
      groups.map((g) => (
        <div class="deck" data-deck={g.id}>
          <div
            class="deck__track"
            data-track
            tabindex="0"
            role="group"
            aria-label={`Работы: ${g.title}`}
          >
            {g.items.map((c) => (
              <article class="case" id={`case-${c.id}`}>
                <div class="case__inner">
                  <p class="case__meta">
                    <span class="case__count">
                      <span class="case__roll">
                        <b>{String(c.position).padStart(2, "0")}</b>
                      </span>{" "}
                      / {c.total}
                    </span>
                  </p>

                  {/* Every frame is lazy: the deck sits well below the fold, and
                      eager-loading the first cards put hundreds of KB into the first view
                      for pictures nobody had scrolled to yet. */}
                  <div class="case__frame" data-layout={c.layout}>
                    {c.frames.map((f) => (
                      <Image
                        src={f.src!}
                        alt={
                          f.role
                            ? `${c.serviceTitle}, работа ${c.number} — ${ROLE_ALT[f.role]}`
                            : `${c.serviceTitle}, работа ${c.number} — до и после, одним кадром`
                        }
                        widths={[360, 560, 760, 1000]}
                        width={1000}
                        sizes={c.layout === "pair" ? "(min-width: 900px) 31vw, 47vw" : "(min-width: 900px) 62vw, 94vw"}
                        format="avif"
                        quality={60}
                        loading="lazy"
                        decoding="async"
                        class="case__img"
                      />
                    ))}

                    {/* On the picture, not under it: on a phone nobody scrolled far enough
                        to find them below, and nothing else said the cards move sideways. */}
                    <button class="deck__arrow deck__arrow--prev" type="button" data-dir="-1" aria-label="Предыдущая работа">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 4 7 12l8 8" /></svg>
                    </button>
                    <button class="deck__arrow deck__arrow--next" type="button" data-dir="1" aria-label="Следующая работа">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 4 8 8-8 8" /></svg>
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>

        </div>
      ))
    }
  </div>
</section>

<style>
  .works {
    position: relative;
    padding-block: var(--mk-section-y);
    overflow: clip;
  }

  .works__head {
    margin-bottom: var(--mk-space-6);
  }

  /* The heading arrives line by line from behind its own mask, the same gesture as the
     hero, so the page has one vocabulary instead of a different effect per section. */
  .works__title {
    font-size: var(--mk-step-h2);
    line-height: 1.02;
    letter-spacing: var(--mk-tracking-display);
    font-weight: 400;
    margin-bottom: var(--mk-space-5);
  }

  .works__title .line {
    display: block;
  }

  .works__lead {
    font-size: var(--mk-step-lead);
    line-height: var(--mk-leading-body);
    color: var(--mk-muted);
    max-width: 32rem;
  }

  /* ---- group switch: a rule that slides, not a pill ---- */
  .works__tabs {
    display: flex;
    gap: var(--mk-space-6);
    margin-bottom: var(--mk-space-5);
  }

  .works__tab {
    display: inline-flex;
    align-items: baseline;
    gap: var(--mk-space-2);
    min-height: var(--mk-hit);
    padding-block: var(--mk-space-2);
    cursor: pointer;
    position: relative;
    color: color-mix(in oklab, var(--mk-text) 42%, transparent);
    transition: color var(--mk-dur-base) var(--mk-ease-out);
  }

  .works__tab-name {
    font-family: var(--mk-font-display);
    font-size: var(--mk-step-h3);
  }

  .works__tab-n {
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    color: var(--mk-accent);
  }

  .works__tab::after {
    content: "";
    position: absolute;
    inset: auto 0 6px 0;
    height: 1px;
    background-color: var(--mk-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--mk-dur-base) var(--mk-ease-out);
  }

  #works-tab-brows:checked ~ .works__tabs .works__tab:nth-child(1),
  #works-tab-coverup:checked ~ .works__tabs .works__tab:nth-child(2) {
    color: var(--mk-text);
  }

  #works-tab-brows:checked ~ .works__tabs .works__tab:nth-child(1)::after,
  #works-tab-coverup:checked ~ .works__tabs .works__tab:nth-child(2)::after {
    transform: scaleX(1);
  }

  #works-tab-brows:checked ~ .works__decks [data-deck="coverup"],
  #works-tab-coverup:checked ~ .works__decks [data-deck="brows"] {
    display: none;
  }

  #works-tab-brows:focus-visible ~ .works__tabs .works__tab:nth-child(1),
  #works-tab-coverup:focus-visible ~ .works__tabs .works__tab:nth-child(2) {
    outline: 2px solid var(--mk-focus);
    outline-offset: 4px;
  }

  /* ---- the deck ---- */
  .deck {
    position: relative;
  }

  .deck__track {
    display: flex;
    align-items: start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .deck__track::-webkit-scrollbar {
    display: none;
  }

  .case {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .case__inner {
    position: relative;
    width: min(100% - 2 * var(--mk-gutter), var(--mk-max-width));
    margin-inline: auto;
    display: grid;
    gap: var(--mk-space-3);
  }

  .case__meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: var(--mk-space-3);
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  .case__count {
    font-variant-numeric: tabular-nums;
  }

  .case__count b {
    font-weight: 500;
    color: var(--mk-text);
  }

  /* The number rolls up into place as its case arrives, so a swipe reads as a counter
     ticking over rather than text being replaced. */
  .case__roll {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .case__roll b {
    display: block;
  }

  @supports (animation-timeline: view(inline)) {
    @media (prefers-reduced-motion: no-preference) {
      .case__roll b {
        animation: mk-roll linear both;
        animation-timeline: view(inline);
        animation-range: entry 30% cover 46%;
      }
    }
  }

  @keyframes mk-roll {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }

  /* One box per case, and it is the biggest thing on the page: this section is what the
     visitor came for. The box takes the photograph's own shape rather than the other way
     round - several of the supplied collages carry the studio's own baked captions along
     their bottom edge, and any crop cuts straight through them. */
  .case__frame {
    position: relative;
    isolation: isolate;
    /* One square stage for every card. Ten of the nineteen cases are the studio's own
       square collages and the rest will be, so the deck keeps one height and the pictures
       are placed inside it rather than the box being cut to fit them.
       (A per-case ratio was tried first: the cards then differed by 200px and the deck
       lurched on every swipe. A min-height is worse still - next to aspect-ratio it grows
       the WIDTH to match and the card runs off the side of the phone.) */
    aspect-ratio: 1 / 1;
    width: 100%;
    /* start, not the grid's default stretch: a stretched item gets a definite height from
       its row and aspect-ratio is then ignored outright - the square never appeared. */
    align-self: start;
    display: grid;
    /* stretch, not centre: with align-items:center the cell height goes auto, "height:100%"
       on the image resolves against nothing and the picture sticks to the top of the
       square instead of sitting in the middle of it. */
    place-items: stretch;
  }

  /* Two real frames side by side: the same comparison a collage makes, built in CSS, so a
     case the studio has not collaged yet still shows both halves at once. */
  .case__frame[data-layout="pair"] {
    grid-template-columns: 1fr 1fr;
    gap: var(--mk-space-2);
  }

  /* contain, never cover: cropping a collage would cut into the two halves being
     compared, which is the entire content of the image. */
  .case__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: mk-stage-in 720ms var(--mk-ease-out) both;
  }

  /* The warmth of the ground gathers behind the picture. */
  .case__frame::before {
    content: "";
    position: absolute;
    inset: -6% -4%;
    z-index: -1;
    background: radial-gradient(
      58% 54% at 50% 46%,
      color-mix(in oklab, var(--mk-gold) 11%, transparent) 0%,
      transparent 74%
    );
    pointer-events: none;
  }

  @keyframes mk-stage-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(1.02);
    }
  }

  /* ---- arrows, on the picture ---- */
  .deck__arrow {
    display: none;
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--mk-dark-text);
    background-color: color-mix(in oklab, var(--mk-dark-ground) 64%, transparent);
    border: 1px solid color-mix(in oklab, var(--mk-gold) 55%, transparent);
    border-radius: 50%;
    cursor: pointer;
    transition:
      background-color var(--mk-dur-fast) var(--mk-ease-out),
      border-color var(--mk-dur-fast) var(--mk-ease-out),
      color var(--mk-dur-fast) var(--mk-ease-out);
  }

  .deck__arrow svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The arrows are a scripted convenience; swiping and the keyboard work without them. */
  :global(html.js) .deck__arrow {
    display: inline-flex;
  }

  .deck__arrow--prev {
    left: -6px;
  }

  .deck__arrow--next {
    right: -6px;
  }

  .deck__arrow[disabled] {
    opacity: 0.32;
    cursor: default;
  }

  /* Scroll-driven, so the movement follows the finger instead of firing on a timer. */
  @supports (animation-timeline: view(inline)) {
    @media (prefers-reduced-motion: no-preference) {
      .case__frame,
      .case__meta {
        animation: mk-case-in linear both;
        animation-timeline: view(inline);
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes mk-case-in {
    from {
      opacity: 0.2;
      transform: translateY(22px);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .works__tab:hover {
      color: var(--mk-text);
    }

    .deck__arrow:not([disabled]):hover {
      background-color: var(--mk-gold);
      border-color: var(--mk-gold);
      color: var(--mk-on-gold);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .works__tab,
    .works__tab::after,
    .deck__arrow {
      transition-duration: 1ms;
    }

    .case__img {
      animation-duration: 1ms;
    }
  }

  @media (min-width: 900px) {
    .case__inner {
      gap: var(--mk-space-4);
    }

    /* As tall as the viewport allows and no taller: the picture is the argument, so it
       gets the screen, and its width follows from its own ratio. */
    .case__frame {
      height: min(72vh, 740px);
      width: auto;
      max-width: 100%;
      justify-self: center;
    }


    .deck__arrow {
      width: 64px;
      height: 64px;
    }

    .deck__arrow svg {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  // Two jobs only: let the arrows page the deck, and mark that JS is present so they are
  // shown at all. Everything else in this section is CSS.
  document.documentElement.classList.add("js");

  for (const deck of document.querySelectorAll<HTMLElement>("[data-deck]")) {
    const track = deck.querySelector<HTMLElement>("[data-track]");
    if (!track) continue;

    const arrows = [...deck.querySelectorAll<HTMLButtonElement>(".deck__arrow")];

    for (const btn of arrows) {
      btn.addEventListener("click", () => {
        const dir = Number(btn.dataset.dir ?? 1);
        track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });
      });
    }

    // An arrow that cannot go anywhere says so, rather than looking broken.
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      for (const btn of arrows) {
        const back = Number(btn.dataset.dir) < 0;
        btn.disabled = back ? track.scrollLeft <= 2 : track.scrollLeft >= max;
      }
    };
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>
