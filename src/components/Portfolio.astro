---
import CaseCard from "./CaseCard.astro";
import cases from "../content/cases.json";

// Strongest proof first. A full before -> fresh -> healed set is the only thing
// that answers "how will this look once it settles", which the studio's research
// names as the decisive question. Pairs come next, then everything else.
const RANK: Record<string, number> = { timeline: 0, pair: 1, collage: 2, single: 3, unknown: 4 };
const byRank = (a: (typeof cases)[number], b: (typeof cases)[number]) =>
  RANK[a.kind] - RANK[b.kind] || a.number - b.number;

const groups = [
  {
    id: "brows",
    title: "Брови",
    note: "Форма по геометрии лица, цвет под типаж.",
    items: cases.filter((c) => c.service === "brows").sort(byRank),
  },
  {
    id: "coverup",
    title: "Перекрытие старого перманента",
    note: "Работа поверх чужого пигмента. Берётся не любой случай — часть сначала требует осветления.",
    items: cases.filter((c) => c.service === "correction").sort(byRank),
  },
];

const timelines = cases.filter((c) => c.kind === "timeline").length;
---

<section class="mk-on-light mk-section portfolio" id="works">
  <div class="mk-container">
    <header class="portfolio__head">
      <p class="mk-eyebrow">Работы</p>
      <h2 class="portfolio__title">Свежая работа и та же работа через месяц</h2>
      <p class="mk-lead portfolio__lead">
        Сразу после процедуры цвет всегда ярче. Когда сходят корочки, он уходит примерно
        на 40–50%, а кожа восстанавливается целый месяц. Поэтому здесь показаны обе стадии,
        а не только эффектный кадр в день процедуры.
      </p>
      {
        timelines > 0 && (
          <p class="portfolio__count">
            Полных наборов «до — сразу после — зажившее»: {timelines}
          </p>
        )
      }
    </header>

    {
      groups.map((g) => (
        <div class="group" id={g.id}>
          <div class="group__head">
            <h3 class="group__title">{g.title}</h3>
            <p class="group__note">{g.note}</p>
            <p class="group__hint" aria-hidden="true">
              Листайте вбок →
            </p>
          </div>

          {/*
            A horizontal scroll-snap track on phones. Nineteen cases stacked in one
            column made the page 21 600px tall; swiping is the native pattern here and
            the partially visible next card is what tells you there is more.
            From 680px up this becomes an ordinary grid and nothing scrolls sideways.
          */}
          <ul class="group__track" role="list">
            {g.items.map((c, i) => (
              <li class="group__item">
                <CaseCard data={c} index={i} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .portfolio__head {
    max-width: 46rem;
    margin-bottom: var(--mk-space-8);
  }

  .portfolio__title {
    margin-block: var(--mk-space-4) var(--mk-space-5);
  }

  .portfolio__lead {
    max-width: var(--mk-measure);
  }

  .portfolio__count {
    margin-top: var(--mk-space-4);
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
  }

  .group + .group {
    margin-top: var(--mk-space-9);
  }

  .group__head {
    margin-bottom: var(--mk-space-5);
  }

  .group__note {
    margin-top: var(--mk-space-2);
    font-size: var(--mk-step-small);
    color: var(--mk-muted);
    max-width: var(--mk-measure);
  }

  .group__hint {
    margin-top: var(--mk-space-3);
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  .group__track {
    display: flex;
    gap: var(--mk-space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Bleed the track through the page gutter so a card can sit flush at the edge
       while its neighbour peeks in - that peek is the affordance. */
    margin-inline: calc(var(--mk-gutter) * -1);
    padding-inline: var(--mk-gutter);
    padding-bottom: var(--mk-space-3);
    /* scroll-snap-align aligns to the SNAPPORT, which ignores padding - without this
       the browser scrolls the track by one gutter on load and the first card sits
       flush against the screen edge. scroll-padding is what insets the snapport. */
    scroll-padding-inline: var(--mk-gutter);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }

  .group__item {
    flex: 0 0 85vw;
    max-width: 340px;
    scroll-snap-align: start;
  }

  @media (min-width: 680px) {
    .group__hint {
      display: none;
    }

    .group__track {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--mk-space-7) var(--mk-space-5);
      overflow-x: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    /* Cards stay narrow on purpose. Several "before" frames arrived at 576-1024px
       wide because clients send them by messenger, and a wide card would show that. */
    .group__item {
      flex: initial;
      max-width: none;
    }
  }
</style>
