---
import { Image } from "astro:assets";
import site from "../data/site.json";
import Logo from "./Logo.astro";

const interior = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/studio/*.png", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

const primary = site.phones.find((p) => p.primary)!;
const { telegram, max } = site.links;
const year = new Date().getFullYear();

// The old footer was one column of everything. These are the four questions a person
// actually asks before booking, each answered on its own card.
const facts = [
  {
    label: "Адрес",
    lines: [`${site.address.city}, ${site.address.street}`, site.address.floor],
    note: "Есть парковка. Как пройти — подскажу по телефону, когда будете рядом.",
    link: { href: site.links.yandexMaps, text: "Открыть в Яндекс Картах" },
  },
  {
    label: "Часы",
    lines: [site.hours.time, site.hours.days],
    note: site.hours.note,
  },
  {
    label: "Телефон",
    lines: site.phones.map((p) => p.display),
    note: "Оба номера — мои, отвечаю сама.",
    tels: site.phones,
  },
  {
    label: "Мессенджеры",
    lines: [],
    note: "Оба — на основном номере.",
    messengers: [
      { href: telegram, text: `Telegram — @${telegram.split("/").pop()}` },
      max
        ? { href: max, text: "MAX — открыть чат" }
        : { href: null, text: `MAX — по номеру ${primary.display}` },
    ],
  },
];
---

<section class="mk-on-dark contacts" id="contacts">
  <div class="contacts__ambient" aria-hidden="true"></div>

  <div class="mk-container">
    <div class="contacts__call" data-reveal="stagger">
      <p class="mk-eyebrow">Запись</p>
      <h2 class="contacts__title">Приходите — разберёмся с вашим случаем</h2>
      <p class="mk-lead contacts__lead">
        Если у вас старый перманент, пришлите фото при дневном свете. По фото скажу, что
        можно сделать, и не буду обещать заранее того, чего не увижу.
      </p>

      <div class="contacts__actions">
        <a class="mk-btn mk-btn--primary" href={site.booking.dikidi} rel="noopener">
          Записаться онлайн
        </a>
        <a class="mk-btn mk-btn--ghost" href={telegram} rel="noopener">Написать в Telegram</a>
        {
          max && (
            <a class="mk-btn mk-btn--ghost" href={max} rel="noopener">
              Написать в MAX
            </a>
          )
        }
      </div>

      <p class="contacts__note">{site.booking.depositNote}</p>
    </div>

    {/* Four cards, one question each, instead of one column holding everything. */}
    <ul class="facts" role="list">
      {
        facts.map((f, i) => (
          <li class="fact" data-reveal style={`--i:${i % 4}`}>
            <p class="fact__label">{f.label}</p>

            {f.tels ? (
              <p class="fact__lines">
                {f.tels.map((t) => (
                  <a class="fact__link fact__link--tel" href={t.href}>
                    {t.display}
                  </a>
                ))}
              </p>
            ) : (
              f.lines.length > 0 && (
                <p class="fact__lines">
                  {f.lines.map((l) => (
                    <span>{l}</span>
                  ))}
                </p>
              )
            )}

            {f.messengers && (
              <p class="fact__lines">
                {f.messengers.map((m) =>
                  m.href ? (
                    <a class="fact__link" href={m.href} rel="noopener">
                      {m.text}
                    </a>
                  ) : (
                    <span>{m.text}</span>
                  ),
                )}
              </p>
            )}

            <p class="fact__note">{f.note}</p>

            {f.link && (
              <a class="fact__link fact__link--out" href={f.link.href} rel="noopener nofollow">
                {f.link.text}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <ul class="interior" role="list">
      {
        interior.map((img, i) => (
          <li data-reveal="wipe" style={`--i:${i % 3}`}>
            <Image
              src={img}
              alt={`Студия Milkim в Омске, интерьер ${i + 1}`}
              widths={[260, 420, 640]}
              width={640}
              sizes="(min-width: 760px) 30vw, 80vw"
              format="avif"
              quality={60}
              loading="lazy"
              decoding="async"
              class="interior__img mk-melt"
            />
          </li>
        ))
      }
    </ul>
  </div>

  <footer class="mk-container foot">
    <div class="foot__brand-row">
      <Logo class="foot__brand" label={`${site.name} — ${site.tagline}`} />
      <p class="foot__cards">
        <a class="fact__link" href={site.links.yandexMaps} rel="noopener nofollow">
          Яндекс Карты
        </a>
        <a class="fact__link" href={site.links.twogis} rel="noopener nofollow">2ГИС</a>
        <a class="fact__link" href={site.links.avito} rel="noopener nofollow">Авито</a>
        <a class="fact__link" href={site.links.vk} rel="noopener nofollow">ВКонтакте</a>
      </p>
    </div>

    <div class="foot__legal-row">
      <p class="foot__legal">
        {site.legal.entity}<br />
        ОГРНИП {site.legal.ogrnip} · ИНН {site.legal.inn}
      </p>
      <p class="foot__legal">
        Перманентный макияж — косметологическая процедура. Есть противопоказания,{" "}
        <a class="fact__link" href="#faq">ознакомьтесь с ними</a>{" "}и при сомнениях
        проконсультируйтесь со специалистом.
      </p>
      <p class="foot__legal foot__legal--year">© {year} {site.name}, {site.city}</p>
    </div>
  </footer>
</section>

<style>
  .contacts {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--mk-section-y) var(--mk-space-6);
  }

  /* The hero's concentric motif, mirrored to the far corner so the page closes the way
     it opened. It drifts, but only where there is a real pointer and real motion
     appetite: on a phone an endless loop in view is battery and reads as a banner. */
  .contacts__ambient {
    position: absolute;
    inset: auto -30% -30% -30%;
    height: 120%;
    z-index: -1;
    background:
      radial-gradient(
        55% 40% at 22% 88%,
        color-mix(in oklab, var(--mk-gold) 12%, transparent) 0%,
        transparent 70%
      ),
      repeating-radial-gradient(
        circle at 22% 88%,
        transparent 0 46px,
        color-mix(in oklab, var(--mk-gold) 7%, transparent) 46px 47px
      );
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .contacts__ambient {
      animation: mk-drift 48s linear infinite alternate;
    }
  }

  @keyframes mk-drift {
    to {
      transform: translate3d(3%, -2%, 0) scale(1.06);
    }
  }

  .contacts__call {
    max-width: 44rem;
    margin-bottom: var(--mk-space-8);
  }

  .contacts__title {
    margin-block: var(--mk-space-4) var(--mk-space-5);
  }

  .contacts__lead {
    margin-bottom: var(--mk-space-6);
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-3);
    margin-bottom: var(--mk-space-4);
  }

  .contacts__note {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
    max-width: var(--mk-measure);
  }

  /* ---- the four cards ---- */
  .facts {
    display: grid;
    gap: var(--mk-space-4);
    margin-bottom: var(--mk-space-8);
  }

  .fact {
    display: grid;
    gap: var(--mk-space-2);
    align-content: start;
    padding-top: var(--mk-space-4);
    border-top: 1px solid var(--mk-rule);
  }

  .fact__label {
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  .fact__lines {
    display: grid;
    gap: var(--mk-space-1);
    font-size: var(--mk-step-body);
    font-variant-numeric: tabular-nums;
  }

  .fact__note {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
  }

  .fact__link {
    color: var(--mk-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    min-height: var(--mk-hit);
    display: inline-flex;
    align-items: center;
  }

  .fact__link--tel {
    font-size: var(--mk-step-body);
    font-variant-numeric: tabular-nums;
  }

  .fact__link--out {
    font-size: var(--mk-step-small);
  }

  .interior {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--mk-space-2);
    margin-bottom: var(--mk-space-8);
  }

  .interior__img {
    width: 100%;
    height: auto;
    /* Same lesson as the process strip: these are landscape frames of the room, and a
       portrait crop throws the room away. 4:5 is as tall as they take. */
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 46%;
  }

  /* ---- footer ---- */
  .foot {
    padding-top: var(--mk-space-6);
    border-top: 1px solid var(--mk-rule);
    display: grid;
    gap: var(--mk-space-6);
  }

  .foot__brand-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--mk-space-4);
  }

  :global(.foot__brand) {
    width: 118px;
    color: var(--mk-gold);
  }

  .foot__cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-2) var(--mk-space-5);
  }

  .foot__legal-row {
    display: grid;
    gap: var(--mk-space-4);
  }

  .foot__legal {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
    max-width: 34rem;
  }

  .foot__legal--year {
    font-size: var(--mk-step-label);
  }

  @media (hover: hover) and (pointer: fine) {
    .fact__link:hover {
      color: var(--mk-dark-text);
    }
  }

  @media (min-width: 640px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }

    .foot__legal-row {
      grid-template-columns: 1fr 1fr auto;
      align-items: start;
      gap: var(--mk-space-6);
    }
  }
</style>
