---
import { Image } from "astro:assets";
import site from "../data/site.json";
import Logo from "./Logo.astro";

const interior = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/studio/*.png", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

const primary = site.phones.find((p) => p.primary)!;
const telegram = site.links.telegram;
const year = new Date().getFullYear();
---

<section class="mk-on-dark contacts" id="contacts">
  <div class="contacts__ambient" aria-hidden="true"></div>

  <div class="mk-container">
    <ul class="interior" role="list">
      {
        interior.map((img, i) => (
          <li>
            <Image
              src={img}
              alt={`Студия Milkim в Омске, интерьер ${i + 1}`}
              widths={[260, 420, 640]}
              width={640}
              sizes="(min-width: 760px) 30vw, 80vw"
              format="avif"
              quality={60}
              loading="lazy"
              decoding="async"
              class="interior__img"
            />
          </li>
        ))
      }
    </ul>

    <div class="contacts__grid">
      <div class="contacts__main">
        <p class="mk-eyebrow">Запись</p>
        <h2 class="contacts__title">Приходите — разберёмся с вашим случаем</h2>
        <p class="mk-lead contacts__lead">
          Если у вас старый перманент, пришлите фото при дневном свете. По фото я скажу,
          что можно сделать, и не буду обещать заранее того, чего не увижу.
        </p>

        <div class="contacts__actions">
          <a class="mk-btn mk-btn--primary" href={site.booking.dikidi} rel="noopener">
            Записаться онлайн
          </a>
          <a class="mk-btn mk-btn--ghost" href={telegram} rel="noopener">Написать в Telegram</a>
          {
            site.links.max && (
              <a class="mk-btn mk-btn--ghost" href={site.links.max} rel="noopener">
                Написать в MAX
              </a>
            )
          }
        </div>

        <p class="contacts__note">{site.booking.depositNote}</p>
      </div>

      <dl class="details">
        <div class="details__row">
          <dt>Адрес</dt>
          <dd>
            {site.address.city}, {site.address.street}, {site.address.floor}
            <span class="details__sub">
              {site.address.parking && "Есть парковка. "}{site.address.note}
            </span>
          </dd>
        </div>

        <div class="details__row">
          <dt>Часы</dt>
          <dd>
            {site.hours.days}, {site.hours.time}
            <span class="details__sub">{site.hours.note}</span>
          </dd>
        </div>

        <div class="details__row">
          <dt>Телефон</dt>
          <dd>
            {
              site.phones.map((p) => (
                <a class="details__link" href={p.href}>
                  {p.display}
                </a>
              ))
            }
          </dd>
        </div>

        <div class="details__row">
          <dt>Мессенджеры</dt>
          <dd>
            <a class="details__link" href={telegram} rel="noopener">
              Telegram — @{telegram.split("/").pop()}
            </a>
            {
              site.links.max ? (
                <a class="details__link" href={site.links.max} rel="noopener">
                  MAX — написать
                </a>
              ) : (
                /* Deliberately not a link. A tel: href under a MAX label would place
                   a call, which is not what the label promises. */
                <span class="details__max">MAX — по номеру {primary.display}</span>
              )
            }
            <span class="details__sub">
              Оба мессенджера — на основном номере. В MAX собеседника находят по номеру
              телефона, прямой ссылки на чат в нём нет.
            </span>
          </dd>
        </div>

        <div class="details__row">
          <dt>Карточки</dt>
          <dd class="details__cards">
            <a class="details__link" href={site.links.yandexMaps} rel="noopener nofollow">
              Яндекс Карты
            </a>
            <a class="details__link" href={site.links.twogis} rel="noopener nofollow">2ГИС</a>
            <a class="details__link" href={site.links.avito} rel="noopener nofollow">Авито</a>
            <a class="details__link" href={site.links.vk} rel="noopener nofollow">ВКонтакте</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <footer class="mk-container foot">
    <Logo class="foot__brand" label={`${site.name} — ${site.tagline}`} />
    <p class="foot__legal">
      {site.legal.entity}<br />
      ОГРНИП {site.legal.ogrnip} · ИНН {site.legal.inn}
    </p>
    <p class="foot__legal">
      Перманентный макияж — косметологическая процедура. Есть противопоказания,
      <a class="details__link" href="#faq">ознакомьтесь с ними</a> и при сомнениях
      проконсультируйтесь со специалистом.
    </p>
    <p class="foot__legal foot__legal--year">© {year} {site.name}, {site.city}</p>
  </footer>
</section>

<style>
  .contacts {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--mk-section-y) var(--mk-space-6);
  }

  /* Same concentric motif as the hero, mirrored to the other corner so the page
     closes the way it opened. */
  .contacts__ambient {
    position: absolute;
    inset: auto -30% -30% -30%;
    height: 120%;
    z-index: -1;
    background:
      radial-gradient(
        55% 40% at 22% 88%,
        color-mix(in oklab, var(--mk-gold) 12%, transparent) 0%,
        transparent 70%
      ),
      repeating-radial-gradient(
        circle at 22% 88%,
        transparent 0 46px,
        color-mix(in oklab, var(--mk-gold) 7%, transparent) 46px 47px
      );
  }

  .interior {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--mk-space-2);
    margin-bottom: var(--mk-space-8);
  }

  .interior__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .contacts__grid {
    display: grid;
    gap: var(--mk-space-8);
  }

  .contacts__title {
    margin-block: var(--mk-space-4) var(--mk-space-5);
  }

  .contacts__lead {
    margin-bottom: var(--mk-space-6);
  }

  .contacts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-3);
    margin-bottom: var(--mk-space-4);
  }

  .contacts__note {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
    max-width: var(--mk-measure);
  }

  .details {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .details__row {
    display: grid;
    gap: var(--mk-space-1);
    padding-block: var(--mk-space-4);
    border-top: 1px solid var(--mk-rule);
  }

  .details dt {
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-faint);
  }

  .details dd {
    margin: 0;
    font-size: var(--mk-step-body);
    display: grid;
    gap: var(--mk-space-1);
  }

  .details__max {
    font-size: var(--mk-step-body);
    font-variant-numeric: tabular-nums;
  }

  .details__sub {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
  }

  .details__cards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-2) var(--mk-space-5);
  }

  .details__link {
    color: var(--mk-gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    min-height: var(--mk-hit);
    display: inline-flex;
    align-items: center;
    font-variant-numeric: tabular-nums;
  }

  /* ---- footer ---- */
  .foot {
    margin-top: var(--mk-space-9);
    padding-top: var(--mk-space-6);
    border-top: 1px solid var(--mk-rule);
    display: grid;
    gap: var(--mk-space-4);
  }

  :global(.foot__brand) {
    width: 118px;
    color: var(--mk-gold);
  }

  .foot__legal {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
    max-width: 46rem;
  }

  .foot__legal--year {
    font-size: var(--mk-step-label);
  }

  @media (min-width: 900px) {
    .contacts__grid {
      grid-template-columns: 1fr minmax(0, 26rem);
      gap: var(--mk-space-9);
      align-items: start;
    }

    .details__row:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
