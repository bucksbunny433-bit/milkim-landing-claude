---
import { Image } from "astro:assets";
import site from "../data/site.json";
import Logo from "./Logo.astro";
import heroImage from "../assets/images/hero-craft.png";

// One messenger above the fold, by the studio's call: MAX.
const { max } = site.links;
---

<section class="mk-on-dark hero">
  {/*
    The photograph is the whole stage, not a picture pasted onto a dark panel. It sits
    behind everything at full bleed and the ground colour comes back through a scrim, so
    there is no edge where the image stops and the section starts.
  */}
  <div class="hero__media" data-settle>
    <Image
      src={heroImage}
      alt="Анастасия, мастер перманентного макияжа Milkim, с аппаратом для процедуры"
      widths={[420, 640, 900, 1280, 1800]}
      width={1800}
      sizes="100vw"
      format="avif"
      quality={64}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="hero__img"
    />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  {/* A soft gold light that follows the pointer across the photograph. Desktop only:
      on a touch screen there is no pointer to follow. */}
  <div class="hero__light" aria-hidden="true"></div>

  <div class="mk-container hero__inner">
    <div class="hero__top">
      <Logo class="hero__logo" label={`${site.name} — ${site.tagline}`} />
    </div>

    <div class="hero__copy">
      {/*
        Fixed line breaks, not whatever the viewport decides. Each line rides up from
        behind its own mask, which only works when a line is a real element.
      */}
      <h1 class="hero__title">
        <span class="line"><span>Брови, которые</span></span>
        <span class="line"><span>выглядят</span></span>
        <span class="line"><span>как ваши</span></span>
      </h1>

      <p class="hero__lead">Форма — по геометрии вашего лица, эскиз — до пигмента.</p>

      <div class="hero__actions">
        <a class="mk-btn mk-btn--primary" href={site.booking.dikidi} rel="noopener">
          Записаться онлайн
        </a>
        {
          max && (
            <a class="mk-btn mk-btn--ghost" href={max} rel="noopener">
              Написать в MAX
            </a>
          )
        }
      </div>
    </div>
  </div>

  {/* Solid ground under the photograph: the split the studio's own research asks for -
      first-timers one way, old pigment the other - on a surface that can carry text. */}
  <div class="hero__band">
    <div class="mk-container">
      <nav class="hero__paths" aria-label="С чего начать">
        <a class="hero__path" href="#process">
          <span class="hero__path-label">Делаю впервые</span>
          <span class="hero__path-hint">Как проходит процедура и что входит в цену</span>
        </a>
        <a class="hero__path" href="#works">
          <span class="hero__path-label">У меня уже есть старый перманент</span>
          <span class="hero__path-hint">Разберу по фото, что можно сделать</span>
        </a>
      </nav>

      <p class="hero__where">
        {site.city}, {site.address.street} · {site.hours.time} · {site.hours.days}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* svh, not vh: on a phone the dynamic toolbar makes vh taller than the screen and
       pushes the buttons under the chrome. Capped so the next section still peeks. */
    min-height: min(100svh, 780px);
    display: grid;
    align-items: end;
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Her brows and the machine sit in the upper third; keep them in frame as the
       viewport gets shorter. */
    object-position: 52% 28%;
  }

  /* The ground colour returns through the photograph rather than meeting it at a line.
     Two stops carry the text: the copy sits where the scrim is past 90%, which keeps
     bone-on-ground contrast at its measured 17.30:1 rather than something accidental. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      /* A short vignette at the very top so the wordmark holds against her hair. */
      linear-gradient(
          to bottom,
          color-mix(in srgb, var(--mk-dark-ground) 62%, transparent) 0%,
          transparent 14%
        ),
      /* Open across the top half - her brows and the gold tip are the argument - then
         solid before the headline starts, so the copy sits at its measured 17.30:1 and
         never over skin. */
      linear-gradient(
          to bottom,
          transparent 22%,
          color-mix(in srgb, var(--mk-dark-ground) 26%, transparent) 28%,
          color-mix(in srgb, var(--mk-dark-ground) 76%, transparent) 34%,
          color-mix(in srgb, var(--mk-dark-ground) 96%, transparent) 39%,
          var(--mk-dark-ground) 43%
        ),
      radial-gradient(
        120% 55% at 50% 4%,
        color-mix(in oklab, var(--mk-gold) 12%, transparent) 0%,
        transparent 62%
      );
  }

  .hero__light {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero__light {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0;
      background: radial-gradient(
        22rem 22rem at var(--mk-x, 50%) var(--mk-y, 40%),
        color-mix(in oklab, var(--mk-gold) 26%, transparent) 0%,
        transparent 70%
      );
      transition: opacity var(--mk-dur-base) var(--mk-ease-out);
    }

    .hero:hover .hero__light {
      opacity: 1;
    }
  }

  .hero__inner {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--mk-space-6);
    padding-block: var(--mk-space-5) var(--mk-space-7);
    min-height: min(100svh, 780px);
  }

  .hero__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--mk-space-4);
  }

  :global(.hero__logo) {
    width: 124px;
    color: var(--mk-gold);
  }

  .hero__where {
    font-size: var(--mk-step-label);
    letter-spacing: var(--mk-tracking-label);
    text-transform: uppercase;
    color: var(--mk-dark-faint);
  }

  .hero__copy {
    align-self: end;
    padding-bottom: var(--mk-space-2);
  }

  .hero__title {
    font-size: var(--mk-step-display);
    line-height: var(--mk-leading-display);
    letter-spacing: var(--mk-tracking-display);
    font-weight: 400;
    margin-bottom: var(--mk-space-5);
  }

  /* Masked line rise. The text never drops to opacity 0, so it paints with the first
     frame and cannot become a late LCP candidate - only its position animates. */
  .hero__title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__title .line > span {
    display: block;
    transform: translateY(110%);
    animation: mk-line-rise 1000ms var(--mk-ease-out) forwards;
  }

  .hero__title .line:nth-child(1) > span {
    animation-delay: 560ms;
  }
  .hero__title .line:nth-child(2) > span {
    animation-delay: 650ms;
  }
  .hero__title .line:nth-child(3) > span {
    animation-delay: 740ms;
  }

  @keyframes mk-line-rise {
    to {
      transform: translateY(0);
    }
  }

  .hero__lead {
    font-size: var(--mk-step-lead);
    line-height: var(--mk-leading-body);
    color: var(--mk-dark-muted);
    max-width: 26rem;
    margin-bottom: var(--mk-space-5);
  }

  .hero__band {
    background-color: var(--mk-dark-ground);
    padding-block: var(--mk-space-2) var(--mk-space-6);
  }

  .hero__paths {
    display: grid;
    margin-bottom: var(--mk-space-5);
  }

  .hero__path {
    display: grid;
    gap: var(--mk-space-1);
    padding-block: var(--mk-space-4);
    min-height: var(--mk-hit);
    text-decoration: none;
    position: relative;
  }

  /* The rule draws itself in rather than appearing. scaleX only - no layout, no paint. */
  .hero__path::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background-color: var(--mk-dark-rule);
    transform: scaleX(0);
    transform-origin: left;
    animation: mk-rule-draw var(--mk-dur-slow) var(--mk-ease-out) forwards;
  }

  .hero__path:nth-child(1)::before {
    animation-delay: 960ms;
  }
  .hero__path:nth-child(2)::before {
    animation-delay: 1060ms;
  }

  .hero__path:last-child::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background-color: var(--mk-dark-rule);
    transform: scaleX(0);
    transform-origin: left;
    animation: mk-rule-draw var(--mk-dur-slow) var(--mk-ease-out) 1160ms forwards;
  }

  @keyframes mk-rule-draw {
    to {
      transform: scaleX(1);
    }
  }

  .hero__path-label {
    font-size: var(--mk-step-lead);
    color: var(--mk-dark-text);
  }

  .hero__path-label::after {
    content: " →";
    color: var(--mk-gold);
    display: inline-block;
    transition: transform var(--mk-dur-fast) var(--mk-ease-out);
  }

  .hero__path-hint {
    font-size: var(--mk-step-small);
    color: var(--mk-dark-faint);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-3);
  }

  /* Everything below the headline arrives after it, in reading order. */
  .hero__top,
  .hero__lead,
  .hero__actions {
    animation: mk-rise-in var(--mk-dur-base) var(--mk-ease-out) backwards;
  }

  .hero__top {
    animation-delay: 520ms;
  }
  .hero__lead {
    animation-delay: 900ms;
  }
  .hero__actions {
    animation-delay: 1080ms;
  }

  @keyframes mk-rise-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* Effect #1, the settle: the photograph eases out of a 6% push-in. It starts only
     once the image has decoded, so the LCP paint itself is never delayed. Resting
     state is scale(1) - without JS the picture is simply correct. */
  .hero__media[data-settle="ready"] .hero__img {
    animation: mk-settle 2000ms var(--mk-ease-out) both;
  }

  @keyframes mk-settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  /* The photograph stays behind while the page moves over it, and the copy leaves a
     little faster than the picture. Scroll-driven, so it tracks the finger exactly and
     costs no JavaScript. Chromium today; everywhere else the hero simply scrolls. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__media {
        animation: mk-hero-sink linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }

      .hero__copy {
        animation: mk-hero-lift linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 70%;
      }
    }
  }

  @keyframes mk-hero-sink {
    to {
      transform: translateY(14%) scale(1.08);
      opacity: 0.45;
    }
  }

  @keyframes mk-hero-lift {
    to {
      transform: translateY(-28%);
      opacity: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__path:hover .hero__path-label::after {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title .line > span {
      transform: none;
      animation: none;
    }

    .hero__path::before,
    .hero__path:last-child::after {
      transform: scaleX(1);
      animation: none;
    }

    .hero__top,
    .hero__lead,
    .hero__actions {
      animation: none;
    }

    .hero__media[data-settle="ready"] .hero__img {
      animation: none;
    }

    .hero__path-label::after {
      transition: none;
    }
  }

  @media (min-width: 900px) {
    .hero {
      min-height: min(100svh, 860px);
    }

    .hero__light {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero__light {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0;
      background: radial-gradient(
        22rem 22rem at var(--mk-x, 50%) var(--mk-y, 40%),
        color-mix(in oklab, var(--mk-gold) 26%, transparent) 0%,
        transparent 70%
      );
      transition: opacity var(--mk-dur-base) var(--mk-ease-out);
    }

    .hero:hover .hero__light {
      opacity: 1;
    }
  }

  .hero__inner {
      min-height: min(100svh, 860px);
    }

    .hero__img {
      object-position: 60% 26%;
    }

    /* The copy takes the left half; the photograph keeps the right, where her face and
       the machine are. The scrim turns horizontal so the text has its own quiet ground. */
    .hero__scrim {
      background:
        linear-gradient(
          to right,
          var(--mk-dark-ground) 0%,
          color-mix(in srgb, var(--mk-dark-ground) 92%, transparent) 28%,
          color-mix(in srgb, var(--mk-dark-ground) 55%, transparent) 46%,
          color-mix(in srgb, var(--mk-dark-ground) 12%, transparent) 66%,
          transparent 100%
        ),
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--mk-dark-ground) 55%, transparent) 0%,
          transparent 22%,
          transparent 72%,
          color-mix(in srgb, var(--mk-dark-ground) 78%, transparent) 100%
        );
    }

    .hero__copy {
      max-width: 34rem;
    }

    .hero__light {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero__light {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      opacity: 0;
      background: radial-gradient(
        22rem 22rem at var(--mk-x, 50%) var(--mk-y, 40%),
        color-mix(in oklab, var(--mk-gold) 26%, transparent) 0%,
        transparent 70%
      );
      transition: opacity var(--mk-dur-base) var(--mk-ease-out);
    }

    .hero:hover .hero__light {
      opacity: 1;
    }
  }

  .hero__inner {
      padding-block: var(--mk-space-7) var(--mk-space-9);
    }
  }
</style>

<script>
  // Pointer effects, desktop only. Both write a custom property and let CSS animate;
  // the handlers are passive and do no layout reads beyond one cached rect.
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !still) {
    const hero = document.querySelector<HTMLElement>(".hero");
    hero?.addEventListener(
      "pointermove",
      (e) => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty("--mk-x", `${e.clientX - r.left}px`);
        hero.style.setProperty("--mk-y", `${e.clientY - r.top}px`);
      },
      { passive: true },
    );

    // Magnetic pull: a button leans toward the cursor while it is near.
    for (const el of document.querySelectorAll<HTMLElement>(".mk-btn, .mk-dock")) {
      el.addEventListener(
        "pointermove",
        (e) => {
          const r = el.getBoundingClientRect();
          el.classList.add("is-pulled");
          el.style.setProperty("--mk-pull-x", String(((e.clientX - (r.left + r.width / 2)) / r.width) * 10));
          el.style.setProperty("--mk-pull-y", String(((e.clientY - (r.top + r.height / 2)) / r.height) * 8));
        },
        { passive: true },
      );
      el.addEventListener("pointerleave", () => {
        el.classList.remove("is-pulled");
        el.style.setProperty("--mk-pull-x", "0");
        el.style.setProperty("--mk-pull-y", "0");
      });
    }
  }

  // Effect #1 only. Waiting on decode() keeps the settle strictly after the LCP paint.
  const media = document.querySelector<HTMLElement>("[data-settle]");
  const img = media?.querySelector("img");
  if (media && img) {
    const start = () => media.setAttribute("data-settle", "ready");
    if (img.complete) img.decode().then(start, start);
    else img.addEventListener("load", () => img.decode().then(start, start), { once: true });
  }
</script>
