---
import { Image } from "astro:assets";
import site from "../data/site.json";
import Logo from "./Logo.astro";
import heroImage from "../assets/images/hero-master.png";

---

<section class="mk-on-dark hero">
  <div class="hero__ambient" aria-hidden="true"></div>

  <div class="mk-container hero__inner">
    <div class="hero__copy">
      <div class="hero__intro">
        {/* The wordmark carries the studio name, so it is the h-level brand mark,
            not decoration. Inline so it can take the section's gold via currentColor. */}
        <Logo class="hero__logo" label={`${site.name} — ${site.tagline}`} />

        <p class="mk-eyebrow hero__where">
          {site.city} · {site.address.street}
        </p>

        <h1 class="hero__title">Брови, которые выглядят как ваши</h1>
      </div>

    <div class="hero__portrait">
      {/*
        LCP element. Eager, high priority, explicit dimensions. It does not animate
        in - the playbook forbids anything moving before LCP.
      */}
      <Image
        src={heroImage}
        alt="Анастасия, мастер перманентного макияжа Milkim, в студии"
        widths={[400, 600, 800, 1200, 1600]}
        width={1600}
        sizes="(min-width: 900px) 46vw, 100vw"
        format="avif"
        quality={62}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="hero__img"
      />
    </div>

      <div class="hero__rest">
      <p class="mk-lead hero__lead">
        Форма строится по геометрии вашего лица, а не по шаблону. Цвет подбираю под ваш
        типаж. Эскиз отрисовываю до внесения пигмента — вы видите форму заранее.
      </p>

      {/*
        Two entry paths, per the studio's own research: a broad brand of natural
        permanent makeup with a separate branch for old pigment. The second path
        leads to assessment, never straight to booking.
      */}
      <nav class="hero__paths" aria-label="С чего начать">
        <a class="hero__path" href="#process">
          <span class="hero__path-label">Делаю впервые</span>
          <span class="hero__path-hint">Как проходит процедура и что входит в цену</span>
        </a>
        <a class="hero__path" href="#coverup">
          <span class="hero__path-label">У меня уже есть старый перманент</span>
          <span class="hero__path-hint">Разберу по фото, что можно сделать в вашем случае</span>
        </a>
      </nav>

      <div class="hero__actions">
        <a class="mk-btn mk-btn--primary" href={site.booking.dikidi} rel="noopener">
          Записаться онлайн
        </a>
        {/* One messenger above the fold, by the studio's call: MAX. Telegram keeps
            its own button and its handle in the contacts block. */}
        {
          site.links.max && (
            <a class="mk-btn mk-btn--ghost" href={site.links.max} rel="noopener">
              Написать в MAX
            </a>
          )
        }
      </div>

      <p class="hero__note">{site.booking.depositNote}</p>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--mk-space-7) 0;
  }

  /* Ambient concentric rings - the studio's own motif, taken from their printed
     price card, which extends the spiral in the emblem. Pure CSS, zero bytes.
     No animation: this sits above the fold and nothing moves before LCP. */
  .hero__ambient {
    position: absolute;
    inset: -20% -30% auto -30%;
    height: 150%;
    z-index: -1;
    background:
      radial-gradient(
        60% 45% at 72% 12%,
        color-mix(in oklab, var(--mk-gold) 14%, transparent) 0%,
        transparent 70%
      ),
      repeating-radial-gradient(
        circle at 72% 12%,
        transparent 0 46px,
        color-mix(in oklab, var(--mk-gold) 9%, transparent) 46px 47px
      );
    opacity: 0.85;
  }

  .hero__inner {
    display: grid;
    gap: var(--mk-space-7);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
  }

  /* On a phone the two wrappers dissolve, so the children flow in DOM order and the
     portrait sits between the headline and the lead. On a wide screen they become
     real blocks and the portrait moves to its own column. */
  .hero__intro,
  .hero__rest {
    display: contents;
  }

  /* :global because Astro scopes styles per component - a class handed to a child
     component lands on an element that carries the child's scope, not this one's. */
  :global(.hero__logo) {
    width: 148px;
    margin-bottom: var(--mk-space-6);
    color: var(--mk-gold);
  }

  .hero__where {
    margin-bottom: var(--mk-space-4);
  }

  .hero__title {
    margin-bottom: var(--mk-space-6);
  }

  .hero__lead {
    margin-bottom: var(--mk-space-6);
  }

  .hero__paths {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--mk-rule);
    margin-bottom: var(--mk-space-6);
  }

  .hero__path {
    display: grid;
    gap: var(--mk-space-1);
    padding-block: var(--mk-space-4);
    min-height: var(--mk-hit);
    border-bottom: 1px solid var(--mk-rule);
    text-decoration: none;
    transition: border-color var(--mk-dur-fast) var(--mk-ease-out);
  }

  .hero__path-label {
    font-size: var(--mk-step-lead);
    color: var(--mk-text);
  }

  .hero__path-label::after {
    content: " →";
    color: var(--mk-gold);
  }

  .hero__path-hint {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mk-space-3);
    margin-bottom: var(--mk-space-4);
  }

  .hero__note {
    font-size: var(--mk-step-small);
    color: var(--mk-faint);
    max-width: var(--mk-measure);
  }

  .hero__portrait {
    /* Full-bleed out of the container gutter. On a phone the photo sits directly
       under the headline: in this category the face is the argument, and it has to
       land above the fold, not 90px below it. The copy continues underneath. */
    margin-inline: calc(var(--mk-gutter) * -1);
    margin-bottom: var(--mk-space-6);
  }

  .hero__img {
    width: 100%;
    height: auto;
    /* 4:5 rather than the source 2012x2560 - the full frame is too tall on a phone
       and would push the copy off the screen. object-position keeps her face in. */
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__path:hover {
      border-bottom-color: var(--mk-gold);
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: var(--mk-space-8) 0;
    }

    .hero__copy {
      display: grid;
      grid-template-columns: 1fr 44%;
      column-gap: var(--mk-space-8);
      align-items: start;
      padding-bottom: var(--mk-space-9);
    }

    .hero__intro,
    .hero__rest {
      display: block;
      grid-column: 1;
    }

    .hero__intro {
      grid-row: 1;
    }

    .hero__rest {
      grid-row: 2;
    }

    .hero__portrait {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      margin-inline: 0;
      margin-bottom: 0;
    }

    /* A fixed height rather than a ratio. A spanning grid item still sizes the rows
       it spans, so a 3:4 portrait 560px wide came out 750px tall and pushed the
       headline off the first screen. Cropping to a set height keeps the hero on one
       screen and lets the copy define the rhythm. */
    .hero__img {
      aspect-ratio: auto;
      height: 604px;
      object-position: 50% 16%;
    }
  }
</style>
